(version 0.0.9)

(build
 (all_platforms
  ((action
    (progn
     (system
      "python3 -c 'from pathlib import Path; p = Path(\"gluon/sys/unix/gluon_unix_epoll.c\"); s = p.read_text(); old = \"event.data.u64 = ocaml_value;\"; assert s.count(old) == 1; p.write_text(s.replace(old, \"event.data.u64 = (uint64_t)(intptr_t)ocaml_value;\"))'")
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (bytestring config libc ocaml rio uri dune)))

(source
 (fetch
  (url
   https://github.com/riot-ml/gluon/releases/download/0.0.9/gluon-0.0.9.tbz)
  (checksum
   sha512=c366898d59e52d39040debe8ea721caf3800e90e327bbd45345226b384fc72427ac7fd7a9fd0acf040663711d5a6a19a5366af3d31800b53b55732afd8e8fc03)))
