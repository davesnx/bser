(version 1.5)

(build
 (all_platforms
  ((action (run dune build -p %{pkg-self:name} -j %{jobs} @install)))))

(depends
 (all_platforms
  (dune
   ocaml
   bigstringaf
   cstruct
   lwt-dllist
   optint
   psq
   fmt
   hmap
   domain-local-await
   mtime)))

(source
 (fetch
  (url
   https://github.com/ocaml-multicore/eio/releases/download/v1.5/eio-1.5.tbz)
  (checksum
   sha512=4582ac2fb2f8616b3d8ae9670eb7913a78085899b14044408801b30a34fed6c4d32971ba72eedb0cbc3d82c057610cf81c482090e75e2985330fcde96478ac5e)))
