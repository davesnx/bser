(version 0.20.0)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune
   ocaml
   rock
   lwt
   httpaf-lwt-unix
   conf-libev
   logs
   fmt
   mtime
   cmdliner
   ptime
   magic-mime
   yojson
   tyxml
   mirage-crypto
   base64
   astring
   re
   uri
   multipart-form-data)))

(source
 (fetch
  (url
   https://github.com/rgrinberg/opium/releases/download/0.20.0/opium-0.20.0.tbz)
  (checksum
   sha512=59b83e7c8fe5f7ae328fb7f2343fe5b8fb735e8f6ee263cfd6c75bb179688ef7cf2b4586b35a2231ed3f3c1ada543021b7a4759326ae095eb77a5f38b9fa3a8a)))
