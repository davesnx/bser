(version 0.4.0)

(build
 (all_platforms
  ((action
    (run
     ocaml
     pkg/pkg.ml
     build
     --dev-pkg
     %{pkg-self:dev}
     --with-cmdliner
     %{pkg:cmdliner:installed}
     --with-b0
     false
     --with-conf-libblake3
     false
     --with-conf-mbedtls
     false
     --with-conf-libmd
     false
     --with-conf-xxhash
     false
     --with-conf-zlib
     false
     --with-conf-zstd
     false)))))

(depends
 (all_platforms
  (ocaml ocamlfind ocamlbuild topkg conf-pkg-config cmdliner)))

(source
 (fetch
  (url https://erratique.ch/software/bytesrw/releases/bytesrw-0.4.0.tbz)
  (checksum
   sha512=9b307eb85c99a38faad50a82e5fae652758548a527ce6db3dd09a21096b19a860e812a5a10bd30d8cc9b885a6482c068fe6ab3b653ca6bfb640293fe190025ee)))
