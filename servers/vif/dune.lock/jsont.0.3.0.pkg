(version 0.3.0)

(build
 (all_platforms
  ((action
    (run
     ocaml
     pkg/pkg.ml
     build
     --dev-pkg
     %{pkg-self:dev}
     --with-cmdliner
     %{pkg:cmdliner:installed}
     --with-bytesrw
     %{pkg:bytesrw:installed}
     --with-brr
     false)))))

(depends
 (all_platforms
  (ocaml ocamlfind ocamlbuild topkg cmdliner bytesrw)))

(source
 (fetch
  (url https://erratique.ch/software/jsont/releases/jsont-0.3.0.tbz)
  (checksum
   sha512=507ab6b3d8718f322fb74999b3b82dbc1d36037042cb9067e5b8b63df80524a0602cc26e487b6e4ce061d65767162d6ffa00e173d9f51ce66cdd2a63482a350e)))
